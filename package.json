{
  "name": "juice-bot",
  "version": "0.1.0",
  "description": "Discord RPG battle bot scaffold for a deterministic encounter engine.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "format": "prettier --write \"src/**/*.ts\" prisma/**/*.prisma README.md .github/**/*.md",
    "lint": "eslint . --ext .ts",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init --preview-feature",
    "start": "node ./dist/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@discordjs/builders": "^1.7.0",
    "discord-api-types": "^0.38.52",
    "discord.js": "^14.18.0",
    "dotenv": "^16.3.1",
    "prisma": "^5.20.0",
    "@prisma/client": "^5.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "eslint": "^8.57.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.2.0",
    "eslint-plugin-promise": "^6.1.1",
    "prettier": "^3.0.0",
    "tsx": "^4.19.2",
    "typescript": "5.3.3"
  }
}
